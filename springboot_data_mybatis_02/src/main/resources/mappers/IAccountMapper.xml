<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ape.springboot_data_mybatis_02.mapper.IAccountMapper">
    <!-- resultMap -->
    <resultMap id="map1" type="com.ape.springboot_data_mybatis_02.pojo.Account">
        <id property="aid" column="aid"></id>
        <result property="auserid" column="auserid"></result>
        <result property="amoney" column="amoney"></result>
        <!-- 一对一的关系映射：配置封装user的内容-->
        <association property="user"  javaType="com.ape.springboot_data_mybatis_02.pojo.User">
            <id property="userid" column="userid"></id>
            <result column="username" property="username"></result>
            <result column="useraddress" property="useraddress"></result>
            <result column="usersex" property="usersex"></result>
            <result column="userbirthday" property="userbirthday"></result>
        </association>
    </resultMap>
    <!--
    按照账户ID查询账户以及用户数据
    public Account findAccountByAid(int aid); -->
    <select id="findAccountByAid" resultMap="map1" parameterType="int">
        select a.*,u.*
        from account as a,user as u
        where a.auserid = u.userid and a.aid = #{id}
    </select>

</mapper>
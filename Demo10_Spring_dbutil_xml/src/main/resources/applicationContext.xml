<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--注入连接池 数据源-->
    <bean id="dataSource" class="com.mchange.v2.c3p0.ComboPooledDataSource">
        <property name="driverClass" value="com.mysql.cj.jdbc.Driver"></property>
        <property name="jdbcUrl" value="jdbc:mysql://localhost:3306/demo_db?serverTimezone=GMT"></property>
        <property name="user" value="root"></property>
        <property name="password" value="zxcv1234"></property>
    </bean>

    <!--注入queryRunner-->
    <bean id="queryRunner" class="org.apache.commons.dbutils.QueryRunner">
        <constructor-arg name="ds" ref="dataSource"></constructor-arg>
    </bean>

    <!--注入dao-->
    <bean id="daoImp" class="com.ape.dao.DaoImp">
        <property name="queryRunner" ref="queryRunner"></property>
    </bean>

    <!--注入service-->
    <bean id="serviceImp" class="com.ape.service.ServiceImp">
        <property name="dao" ref="daoImp"></property>
    </bean>


    <!--注入controller-->
    <bean id="controllerImp" class="com.ape.controller.ControllerImp">
        <property name="service" ref="serviceImp"></property>
    </bean>
</beans>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ape.springboot_data_mybatis_03.mapper.IUserMapper">


    <select id="findUserByUid" resultType="com.ape.springboot_data_mybatis_03.pojo.User" parameterType="int">
        select * from user
        where userid = #{id}
    </select>


    <resultMap id="map2" type="com.ape.springboot_data_mybatis_03.pojo.User">
        <id property="userid" column="userid"></id>
        <result property="username" column="username"></result>
        <result property="useraddress" column="useraddress"></result>
        <result property="usersex" column="usersex"></result>
        <result property="userbirthday" column="userbirthday"></result>

        <!-- 配置user对象中accounts集合的映射
         <collection property="映射的属性"
            ofType="映射的属性的类型" column="传递的字段"
            select="调用的方法" />
         -->
        <collection property="accounts" ofType="com.ape.springboot_data_mybatis_03.pojo.Account" column="userid" select="com.ape.springboot_data_mybatis_03.mapper.IAccountMapper.findAccountByUser"></collection>

    </resultMap>

    <select id="findUserByUids" resultMap="map2" parameterType="int">
        select * from user
        where userid = #{id}
    </select>

</mapper>